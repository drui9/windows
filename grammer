    def thread(self, function, *args, **kwargs):
        def function_call(metadata):
            metadata['exited'].clear()
            metadata['callable'](*metadata['args'], **metadata['kwargs'])
            metadata['exited'].set()
        # --
        fn_name = function.__name__
        self.runtime['threads'][fn_name] = {
            'exited' : Event(),
            'callable' : function,
            'kwargs': kwargs,
            'args': args
        }
        metadata = self.runtime['threads'][fn_name]
        t = Thread(target=function_call, args=(metadata,))
        metadata['workthread'] = t
        t.start()

    @property
    def stop(self):
        return self.terminate.set()

    @property
    def stopped(self):
        return self.terminate.is_set()

    def local(self):
        self.server()
        self.notificationr()
        self.out_buffer.clear()
