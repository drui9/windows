#!/usr/bin/python
from contextlib import contextmanager
from threading import Thread, Event
from time import perf_counter_ns
from datetime import datetime
from base64 import b64decode
from loguru import logger
import subprocess as sp
import uuid
import time
import sys
import os

class Source:
    runtime = {
        'code': dict(),
        'commands': dict(),
        'actions': dict()
    }
    def __init__(self):
        self.out_buffer = list()
        self.start = datetime.now()
        self.terminate = Event()
        self.instance_id = uuid.uuid4().hex
        self.text ='Enter command or code snippet.'
        logger.remove()
        logfmt = '<green>{line}</green>|<level>{level}</level>|<level>{message}</level>'
        logger.add(sys.stderr, colorize=True, format=logfmt, level='DEBUG')
        logger.info('[{}] started', self.instance_id)

    @contextmanager
    def timeit(self, name='timed process'):
        init = perf_counter_ns()
        yield
        fin = perf_counter_ns()
        logger.debug('{} took: {}', name, init - fin)

    def notification(self, fifo_path, title=None, content=None):
        if not title:
            title ='river'
        if not content:
            content = self.text
        # --
        with self.timeit('notification-remove'):
            task = sp.run([
                'termux-notification-remove',
                self.instance_id
            ])
        # --
        task = sp.run([
            'termux-notification',
            '-i', self.instance_id,
            '-t', title,
            '-c', content,
            '--button1', 'reply',
            f'--button1-action', f'echo $REPLY>{fifo_path}'
        ])

    def clipboard(self, content=None):
        if not content:
            content = self.text
        else:
            content = str(content)
        # --
        task = sp.run([
            'termux-clipboard-set',
            content
        ])

    def toast(self, content=None):
        if not content:
            content = self.text
        # --
        logger.debug('toast: {}', content)
        task = sp.run([
            'termux-toast',
            '-b', 'black',
            '-g', 'top',
            content,
        ])

    @staticmethod
    def module(module_fn, module_name, module_type):
        def wrapper(module_fn):
            logger.debug('module_name: {}', module_name)
            logger.debug('module_type: {}', module_type)
            Source.runtime[module_type][module_name] = module_fn
            return module_fn
        return wrapper(module_fn)

    @staticmethod
    def module_call(module_name, module_type, *args, **kwargs):
        if module_type in Source.runtime:
            if (module:=Source.runtime[module_type].get(module_name)):
                try:
                    logger.debug('{} call:  {}', module_type, module_name)
                    return module(*args, **kwargs)
                except Exception as e:
                    logger.exception(e)

    def initialize(self):
        def pip(command):
            task = sp.Popen([
                '/data/data/com.termux/files/usr/bin/pip',
                *command.split(' ')[1:]
            ], shell=False, stdout=sp.PIPE)
            task.wait()
            return task.returncode, task.stdout.read().decode()
        # --
        def shutdown(*args, **kwargs):
            self.text = 'shutting down...'
            self.toast()
            retcode = 0
            self.terminate.set()
            return retcode, self.text
        # --
        Source.module(pip, 'pip','commands')
        Source.module(shutdown, 'shutdown','commands')
        # --
        logger.debug('code: {}', len(self.runtime['code']))
        logger.debug('commands: {}', len(self.runtime['commands']))
        logger.debug('actions: {}', len(self.runtime['code']))

    def server(self):
        fifo = 'transport'
        if os.path.exists(fifo):
            os.unlink(fifo)
        # --
        os.mkfifo(fifo)
        cwd = os.getcwd()
        fifo_path = os.path.join(cwd, fifo)
        # --
        def read_fifo(fpath):
            while not self.terminate.is_set():
                try:
                    with open(fifo, 'r') as fd:
                        response = fd.read().strip('\n')
                        response_id = uuid.uuid4().hex
                    yield response, response_id
                except KeyboardInterrupt:
                    logger.info('keyboard interrupt')
                    self.terminate.set()
                    break
            # print('deleting fpath')
            os.unlink(fpath)
        # --
        def command_exists(command):
            command_name = command.split(' ')[0]
            if command_name in self.runtime['commands']:
                return command_name
        # --
        self.notification(fifo_path)
        for response, response_id in read_fifo(fifo_path):
            logger.debug(response.encode())
            if command:=command_exists(response):
                retcode, output = Source.module_call(command, 'commands', response)
                logger.debug('{}:<{}>:{}'.format(response_id, retcode, response))
                if isinstance(output, str):
                    self.clipboard(output)
                    self.notification(fifo_path, content=output)
                else:
                    logger.debug(output)
            else:
                try:
                    self.out_buffer.append('response_id: {}'.format(response_id))
                    self.out_buffer.append('response: {}'.format(response))
                    compiled = compile(response, filename='<string>', mode='exec')
                    # exec(compiled, globals={'main': self, 'print': self.clipboard})
                    universe = { 'main': self, 'stdout': self.out_buffer }
                    eval(compiled, globals=universe)
                    outstr = '\n'.join(self.out_buffer)
                    self.clipboard(outstr)
                except Exception as e:
                    logger.exception(e)
                    self.text = str(e)
 
    def local(self):
        self.initialize()
        self.server()
        task = sp.run([
            'termux-notification-remove',
            self.instance_id
        ])
        self.out_buffer.clear()
#********************* <start>
def initialize():
    bot = Source()
    bot.local()
#-- </start>

initialize()

