#!/usr/bin/python
from contextlib import contextmanager
from threading import Thread, Event
from time import perf_counter
from datetime import datetime
from base64 import b64encode
from loguru import logger
import subprocess as sp
import uuid
import time
import sys
import os

class Source:
    runtime = {
        'code': dict(),
        'commands': dict(),
        'actions': dict()
    }
    def __init__(self):
        self.fifo = os.path.join(os.getcwd(), 'transport')
        self.out_buffer = list()
        self.start = datetime.now()
        self.terminate = Event()
        self.instance_id, self.instance_name = [i.strip('\n') for i in sys.stdin.read().split(' ') if i]
        self.text ='Enter command or code snippet.'
        logger.remove()
        self.logfmt = '{time:HH:MM:ss}|<green>{line: <6}</green>|<level>{level}</level>|<level>{message}</level>'
        # logger.add(sys.stdout, colorize=False, format=self.logfmt, level='DEBUG')
        logger.add(lambda x: self.out_buffer.append(x), colorize=False, format=self.logfmt, level='DEBUG')
        logger.info('[{}] started', self.instance_name)

    @contextmanager
    def timeit(self, name='timed process'):
        init = perf_counter()
        yield
        fin = perf_counter()
        logger.debug(f'{name} took: {fin - init:.2f}')

    def notificationr(self):
        with self.timeit('notification-remove'):
            task = sp.run([
                'termux-notification-remove',
                self.instance_id
            ])

    def notification(self, title=None, content=None):
        if not title:
            title = self.instance_name
        if not content:
            content = self.text
        # --
        with self.timeit('notification'):
            task = sp.run([
                'termux-notification',
                '--alert-once',
                '--ongoing',
                '-i', self.instance_id,
                '-t', title,
                '-c', content,
                '--button1', 'reply',
                f'--button1-action', f'echo $REPLY>{self.fifo}'
            ])

    def clipboard(self):
        # --todo: permission to copy to clipboard
        with self.timeit('clipboard-set'):
            task = sp.run([
                'termux-clipboard-set',
                '\n'.join([i.strip('\n').strip() for i in self.out_buffer]).encode()
            ])

    def toast(self, content=None):
        if not content:
            content = self.text
        # --
        content = str(content)
        with self.timeit('toast'):
            task = sp.run([
                'termux-toast',
                '-b', 'white',
                '-c', 'black',
                '-g', 'top',
                content
            ])

    @staticmethod
    def module(module_fn, module_name, module_type):
        def wrapper(module_fn):
            logger.debug('module loaded: {}, {}', module_name, module_type)
            Source.runtime[module_type][module_name] = module_fn
            return module_fn
        return wrapper(module_fn)

    @staticmethod
    def module_call(module_name, module_type, *args, **kwargs):
        if module_type in Source.runtime:
            if (module:=Source.runtime[module_type].get(module_name)):
                try:
                    logger.debug('{} call:  {}', module_type, module_name)
                    return module(*args, **kwargs)
                except Exception as e:
                    logger.exception(e)

    def initialize(self):
        def terminal(command):
            task = sp.Popen(
                [*command.split(' ')[1:]],
                stdout=sp.PIPE,
                stderr=sp.PIPE,
                shell=False,
            )
            task.wait()
            return task.returncode, task.stdout.read().decode() or task.stderr.read().decode()
        # --
        def pip(command):
            task = sp.Popen([
                '/data/data/com.termux/files/usr/bin/pip',
                *command.split(' ')[1:]
            ], shell=False, stdout=sp.PIPE)
            task.wait()
            return task.returncode, task.stdout.read().decode()
        # --
        def shutdown(*args, **kwargs):
            self.text = 'shutting down...'
            self.toast()
            retcode = 0
            self.terminate.set()
            return retcode, self.text
        # --
        Source.module(pip, 'pip','commands')
        Source.module(terminal, 'terminal','commands')
        Source.module(shutdown, 'shutdown','commands')
        # --
        logger.debug('code: {}', len(self.runtime['code']))
        logger.debug('commands: {}', len(self.runtime['commands']))
        logger.debug('actions: {}', len(self.runtime['code']))

    def server(self):
        # --
        def read_fifo():
            if os.path.exists(self.fifo):
                os.unlink(self.fifo)
            # --
            os.mkfifo(self.fifo)
            while not self.terminate.is_set():
                try:
                    with open(self.fifo, 'r') as fd:
                        response = fd.read().strip('\n')
                        response_id = uuid.uuid4().hex
                    yield response, response_id
                except KeyboardInterrupt:
                    logger.info('keyboard interrupt')
                    self.terminate.set()
                    break
            # --
            if os.path.exists(self.fifo):
                os.unlink(self.fifo)
        # --
        def command_exists(command):
            command_name = command.split(' ')[0]
            if command_name in self.runtime['commands']:
                return command_name
        # --
        self.notification()
        for response, response_id in read_fifo():
            if command:=command_exists(response):
                with self.timeit(command):
                    retcode, output = Source.module_call(command, 'commands', response)
                    if not isinstance(output, str):
                        output= str(output)
                    logger.debug('command: {}, retcode: {}\n{}', command, retcode, output)
                self.clipboard()
            else:
                try:
                    code = b64encode(response.encode())
                    compiled = compile(response, filename='<string>', mode='exec')
                    globalz = {
                        self.instance_name: self,
                        'logger': logger,
                        'thread': Thread,
                        'print': logger.debug,
                        'stdout': self.out_buffer,
                        'stop': lambda: self.terminate.set(),
                        'tostop': lambda: self.terminate.is_set()
                    }
                    exec(compiled, locals=globalz)
                    self.clipboard()
                except Exception as e:
                    logger.exception(e)
                    self.clipboard()
 
    def local(self):
        self.initialize()
        self.server()
        self.notificationr()
        self.out_buffer.clear()
#********************* <start>
def initialize():
    bot = Source()
    bot.local()
#-- </start>

if __name__ == '__main__':
    initialize()

