        def read_fifo():
            if os.path.exists(self.fifo):
                os.unlink(self.fifo)
            # --
            os.mkfifo(self.fifo)
            while not self.terminate.is_set():
                try:
                    with open(self.fifo, 'r') as fd:
                        response = fd.read().strip('\n')
                        response_id = uuid.uuid4().hex
